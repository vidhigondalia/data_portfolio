# Copy to .streamlit/secrets.toml and fill in the real value.
# secrets.toml is gitignored; this example file is not.
#
# Use the Supabase SESSION POOLER host (IPv4). The direct connection
# db.<ref>.supabase.co is IPv6-only and fails on IPv4 networks and on
# Streamlit Community Cloud.

SUPABASE_DB_URL = "postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
